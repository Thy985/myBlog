# ========================================
# Myblog 前端环境变量配置模板
# ========================================
# 说明：
# 1. 开发环境：复制为 .env.development
# 2. 生产环境：复制为 .env.production
# 3. 本地覆盖：复制为 .env.local
# 4. .env.local 不会被提交到 Git
# ========================================

# API 基础地址
# 开发环境示例：http://localhost:8080/api
# 生产环境示例：https://api.yourdomain.com/api
VITE_APP_BASE_API='http://localhost:8080/api'

# 应用标题
VITE_APP_TITLE='Myblog'

# 是否启用 Mock 数据
VITE_USE_MOCK=false

# 是否启用代理
VITE_USE_PROXY=true
